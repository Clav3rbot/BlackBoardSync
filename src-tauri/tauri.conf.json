{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlackBoard Sync",
  "version": "1.0.4",
  "identifier": "io.github.clav3rbot.blackboardsync",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev:tauri",
    "beforeBuildCommand": "npm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BlackBoard Sync",
        "width": 480,
        "height": 780,
        "minWidth": 380,
        "minHeight": 520,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#0d1117"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../static/icons/png/128x128.png",
      "../static/icons/mac/icon.icns",
      "../static/icons/win/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "shortcutName": "BlackBoard Sync",
        "installMode": "currentUser"
      }
    }
  }
}
