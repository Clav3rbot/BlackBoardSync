{
  "name": "blackboard-sync",
  "version": "1.1.2",
  "description": "Sincronizza i file dei corsi Blackboard (Università Bocconi)",
  "scripts": {
    "dev": "npx webpack serve --config webpack.dev.config.js",
    "dev:tauri": "webpack serve --config webpack.tauri-dev.config.js",
    "build:renderer": "webpack --config webpack.prod.config.js",
    "tauri": "tauri",
    "lint": "eslint src --ext .ts,.tsx"
